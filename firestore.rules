rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    match /professionalAudit/{id} { allow read: if admin(); allow write: if false; }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data) {
      return data.keys().hasAll(['fullName', 'phone', 'registrationConfirmed', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.phone is string
        && (data.phone == '' || data.phone.matches('^\\+[1-9][0-9]{7,14}$'))
        && data.get('profession', '') is string && data.get('profession', '').size() <= 100
        && data.registrationConfirmed is bool
        && data.get('registrationPath', 'client') in ['client', 'professional']
        && data.get('preferredMode', 'client') in ['client', 'professional']
        && data.get('termsVersion', '') is string && data.get('termsVersion', '').size() <= 100
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validConsent(data) {
      return data.get('termsVersion', '') == '' || (
        get(/databases/$(database)/documents/legalDocuments/current).data.published == true
        && data.termsVersion == get(/databases/$(database)/documents/legalDocuments/current).data.version
        && data.termsAcceptedAt == request.time
      );
    }
    match /users/{uid} {
      // Unverified users need access to their own registration draft, never another profile.
      allow get: if owner(uid) || admin();
      allow create: if owner(uid) && validProfile(request.resource.data) && validConsent(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'profession', 'registrationConfirmed', 'registrationPath',
          'preferredMode', 'termsVersion', 'termsAcceptedAt', 'createdAt', 'updatedAt'
        ]) && request.resource.data.createdAt == request.time;
      // Future roles, verification statuses and other server fields cannot be added or changed.
      allow update: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['termsVersion', 'termsAcceptedAt'])
          || validConsent(request.resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'profession', 'registrationConfirmed', 'registrationPath',
          'preferredMode', 'termsVersion', 'termsAcceptedAt', 'updatedAt'
        ]);
      match /notifications/{id} {
        allow get: if owner(uid);
        allow list: if owner(uid) && request.query.limit != null && request.query.limit <= 100;
        allow create, delete: if false;
        allow update: if owner(uid) && resource.data.get('schemaVersion', 0) == 9
          && resource.data.recipientUid == uid && resource.data.readAt == null
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      }
      match /notificationState/{id} { allow get: if owner(uid); allow list, write: if false; }
      match /messageState/{id} { allow get: if owner(uid) && id == 'inbox'; allow list, write: if false; }
      match /messageReads/{id} { allow get: if owner(uid); allow list, write: if false; }
      match /messageInbox/{id} { allow read, write: if false; }
      match /devices/{id} { allow read, write: if false; }
      match /notificationPreferences/{id} {
        allow get: if owner(uid) && id == 'push';
        allow create, update: if owner(uid) && id == 'push'
          && request.resource.data.keys().hasOnly(['messages','proposals','opportunities','account','messagePreview'])
          && request.resource.data.keys().hasAll(['messages','proposals','opportunities','account'])
          && request.resource.data.messages is bool && request.resource.data.proposals is bool
          && request.resource.data.opportunities is bool && request.resource.data.account is bool
          && request.resource.data.get('messagePreview', false) is bool;
        allow list, delete: if false;
      }
    }
    match /professionalProfiles/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow write: if false;
      match /documents/{kind} { allow get, list: if owner(uid) || admin(); allow write: if false; }
    }
    match /referenceData/{id} { allow get: if id == 'professionalOnboarding'; allow list, write: if false; }
    match /legalDocuments/{id} { allow get: if id == 'current'; allow list, write: if false; }
    // Public projection contains only public request fields, written by publishRequest.
    match /requests/{id} {
      allow get: if resource.data.status == 'published';
      allow list: if resource.data.status == 'published'
        && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }
    match /userRequests/{uid}/items/{id} {
      allow get: if owner(uid) || admin();
      allow list: if (owner(uid) || admin())
        && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }
    match /requestOwnership/{id} { allow read, write: if false; }
    match /proposals/{id} {
      function party() { return request.auth != null && (resource.data.professionalUid == request.auth.uid || resource.data.clientUid == request.auth.uid); }
      allow get: if party();
      allow list: if party() && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }
    match /conversations/{id} {
      function participant(data) { return request.auth != null && (data.clientUid == request.auth.uid || data.professionalUid == request.auth.uid); }
      allow get: if participant(resource.data);
      allow list: if participant(resource.data) && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
      match /messages/{messageId} {
        allow get: if participant(get(/databases/$(database)/documents/conversations/$(id)).data);
        allow list: if participant(get(/databases/$(database)/documents/conversations/$(id)).data)
          && request.query.limit != null && request.query.limit <= 100;
        // Callable sets the authenticated sender, timestamp and last-message metadata atomically.
        allow write: if false;
      }
    }
    match /authEmailChallenges/{challenge} {
      allow read, write: if false;
    }
    match /authEmailRateLimits/{limit} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
