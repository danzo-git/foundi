{
  "functions": [
    {
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env.example",
        ".secret.local",
        ".env*"
      ],
      "source": "functions",
      "predeploy": [],
      "codebase": "auth"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 1620,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 1621,
      "websocketPort": 1626,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 1622,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 1623,
      "host": "127.0.0.1"
    },
    "hub": {
      "port": 1624,
      "host": "127.0.0.1"
    },
    "logging": {
      "port": 1625,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "storage.rules"
  }
}
