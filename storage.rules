rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /requestPhotos/{allPaths=**} {
      // Only authenticated server endpoints can read or write these objects.
      allow read, write: if false;
    }
    match /conversations/{conversationId}/{allPaths=**} {
      // Upload AND read use authenticated server endpoints with participant checks.
      // Firebase object GET can mint a permanent download token, so SDK reads are denied too.
      allow read, write: if false;
    }
    match /professionalDocuments/{uid}/{kind}/{file} {
      // Uploads are validated by the backend; no public download tokens.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
